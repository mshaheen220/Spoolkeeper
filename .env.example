# Port the Express server (and static frontend in production) listens on
PORT=3003

# Folder holding spoolkeeper.db (inventory + enrichment cache)
DATA_DIR=./data

# OrcaSlicer's user preset folder (contains filament/, machine/, process/).
# Defaults to ~/Library/Application Support/OrcaSlicer/user/default on macOS.
# ORCA_USER_DIR=

# Docker only: host path mounted at /orca, if not the macOS default above.
# ORCA_USER_DIR_HOST=

# Timeout (ms) for outbound enrichment fetches (OFD, SpoolmanDB, product pages)
FETCH_TIMEOUT_MS=15000

# CORS origin allowed to hit the API in development (Vite dev server)
CLIENT_ORIGIN=http://localhost:5175
